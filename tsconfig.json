{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "examples",
    "node_modules",
    "evolution-api-repo",
    "scratch",
    "scripts",
    "tests",
    "e2e",
    "src/app/api/cron/**",
    "src/app/api/digital-card/**",
    "src/app/api/google-business/select-location/**",
    "src/app/api/payments/verify/**",
    "src/app/api/qr/standee/**",
    "src/app/api/webhook/evolution/**",
    "src/app/api/whatsapp/connect/**",
    "src/app/dashboard/reviews/**",
    "src/app/q/wallet/**",
    "src/app/uploads/**",
    "src/lib/digital-card-service.ts",
    "src/lib/stamp-engine.ts"
  ]
}

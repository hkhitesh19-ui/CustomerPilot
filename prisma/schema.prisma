generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  password  String?
  role      String    @default("merchant")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  merchant  Merchant?
}

model Merchant {
  id                        String                    @id @default(cuid())
  userId                    String?                   @unique
  name                      String
  businessType              String?
  ownerName                 String?
  address                   String?
  businessTiming            String?
  category                  String?
  timezone                  String?
  whatsappPhone             String?                   @unique
  whatsappInstanceName      String?
  email                     String?
  logoUrl                   String?
  coverUrl                  String?
  plan                      String?                   @default("trial")
  status                    String?                   @default("active")
  trialEndsAt               DateTime?
  onboardingCompleted       Boolean                   @default(false)
  currentStep               Int                       @default(1)
  googleReviewDelayMinutes  Int                       @default(30)
  vipUpgradeBonusStamps     Int                       @default(1)
  loyaltyCategoryNames      String?
  winbackDays1              Int                       @default(30)
  winbackDays2              Int                       @default(60)
  winbackDays3              Int                       @default(90)
  expiryWarningDays         Int                       @default(7)
  almostThereInactivityDays Int                       @default(7)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  auditLogs                 AuditLog[]
  backgroundJobs            BackgroundJob[]
  bills                     Bill[]
  birthdays                 Birthday[]
  campaignDeliveryLogs      CampaignDeliveryLog[]
  cardRuleChangeLogs        CardRuleChangeLog[]
  customers                 Customer[]
  customerMergeLogs         CustomerMergeLog[]
  customerStampCards        CustomerStampCard[]
  fraudAlerts               FraudAlert[]
  googleBusinessReviews     GoogleBusinessReview[]
  incidents                 Incident[]
  user                      User?                     @relation(fields: [userId], references: [id])
  merchantGoogleConnections MerchantGoogleConnection?
  merchantTransferLogs      MerchantTransferLog[]
  messageTemplates          MessageTemplate[]
  onboardingSteps           OnboardingStep[]
  ownerOverrideLogs         OwnerOverrideLog[]
  redemptions               Redemption[]
  referrals                 Referral[]
  reviews                   Review[]
  rewards                   Reward[]
  rewardWaitlists           RewardWaitlist[]
  staff                     Staff[]
  Stamp                     Stamp[]
  stampCards                StampCard[]
  subscriptions             Subscription[]
  supportTickets            SupportTicket[]
  vipTiers                  VipTier[]
  waitingCustomers          WaitingCustomer[]
  whatsAppMessages          WhatsAppMessage[]
  winBackEscalations        WinBackEscalation[]
}

model Incident {
  id         String    @id @default(cuid())
  incidentNo String    @unique
  merchantId String?
  severity   String    @default("MEDIUM")
  title      String
  rootCause  String?
  resolution String?
  status     String    @default("OPEN")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  merchant   Merchant? @relation(fields: [merchantId], references: [id])

  @@index([status])
  @@index([createdAt])
}

model Staff {
  id                          String            @id @default(cuid())
  merchantId                  String
  name                        String
  email                       String?
  phone                       String?
  pin                         String?
  role                        String
  requireManagerApprovalUntil DateTime?
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt
  auditLogs                   AuditLog[]        @relation("StaffAuditLogs")
  billsIssued                 Bill[]
  redemptionsApproved         Redemption[]
  merchant                    Merchant          @relation(fields: [merchantId], references: [id])
  waitingCustomersRecovered   WaitingCustomer[] @relation("RecoveredBy")
  waitingCustomersReserved    WaitingCustomer[] @relation("ReservedBy")
  waitingCustomersClaimed     WaitingCustomer[] @relation("ClaimedBy")

  @@index([merchantId])
}

model Customer {
  id                  String              @id @default(cuid())
  merchantId          String
  name                String
  email               String?
  phone               String
  referralCode        String?
  acquisitionChan     String?
  notes               String?
  lifetimeStamps      Int                 @default(0)
  lifetimeSpend       Float               @default(0)
  lifetimeRedemptions Int                 @default(0)
  currentStreak       Int                 @default(0)
  longestStreak       Int                 @default(0)
  birthday            String?
  favorite            Boolean             @default(false)
  vipTier             String?             @default("none")
  botState            String              @default("IDLE")
  botStateUpdatedAt   DateTime            @default(now())
  lastActiveAt        DateTime?
  status              String?
  whatsappOptIn       Boolean             @default(true)
  referredById        String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  deletedAt           DateTime?           // Soft-delete: set instead of hard delete
  achievements        Achievement[]
  bills               Bill[]
  birthdaysList       Birthday[]
  referredBy          Customer?           @relation("CustomerReferrals", fields: [referredById], references: [id])
  referralsMade       Customer[]          @relation("CustomerReferrals")
  merchant            Merchant            @relation(fields: [merchantId], references: [id])
  stampCards          CustomerStampCard[]
  redemptions         Redemption[]
  referralsReceived   Referral[]          @relation("Friend")
  referrals           Referral[]          @relation("Referrer")
  reviews             Review[]
  stamps              Stamp[]
  waitingCustomers    WaitingCustomer[]
  whatsAppMessages    WhatsAppMessage[]
  winBackEscalations  WinBackEscalation[]

  @@unique([merchantId, phone])
  @@index([merchantId])
  @@index([merchantId, phone])
  @@index([merchantId, status])
  @@index([merchantId, lastActiveAt])
  @@index([merchantId, deletedAt])
}

model StampCard {
  id                 String              @id @default(cuid())
  merchantId         String
  name               String
  stampsRequired     Int
  rewardName         String
  stampsPerBill      String?
  color              String?
  rewardImageUrl     String?
  stampValue         Float?
  validityDays       Int?
  googleReviewBonus  Int?
  photoBonus         Int?
  tierRewardsEnabled Boolean             @default(false)
  excludedCategories String?
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  customerCards      CustomerStampCard[]
  stamps             Stamp[]
  merchant           Merchant            @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
}

model CustomerStampCard {
  id              String    @id @default(cuid())
  customerId      String
  stampCardId     String
  merchantId      String
  stampsCollected Int       @default(0)
  completed       Boolean   @default(false)
  redeemed        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  merchant        Merchant  @relation(fields: [merchantId], references: [id])
  stampCard       StampCard @relation(fields: [stampCardId], references: [id])
  customer        Customer  @relation(fields: [customerId], references: [id])
  stamps          Stamp[]

  @@index([customerId, stampCardId])
  @@index([merchantId])
}

model Stamp {
  id                  String             @id @default(cuid())
  customerId          String
  stampCardId         String?
  customerStampCardId String?
  merchantId          String
  source              String
  billId              String?
  createdAt           DateTime           @default(now())
  deletedAt           DateTime?          // Soft-delete: set instead of hard delete
  bill                Bill?              @relation(fields: [billId], references: [id])
  merchant            Merchant           @relation(fields: [merchantId], references: [id])
  customerStampCard   CustomerStampCard? @relation(fields: [customerStampCardId], references: [id])
  stampCard           StampCard?         @relation(fields: [stampCardId], references: [id])
  customer            Customer           @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([merchantId])
}

model Reward {
  id                      String       @id @default(cuid())
  merchantId              String
  name                    String
  description             String?
  stampsCost              Int
  stock                   Int          @default(0)
  active                  Boolean      @default(true)
  requiresManagerApproval Boolean      @default(false)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  deletedAt               DateTime?    // Soft-delete: set instead of hard delete
  redemptions             Redemption[]
  merchant                Merchant     @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
}

model Bill {
  id            String   @id @default(cuid())
  merchantId    String
  customerId    String
  issuedById    String
  number        String
  amount        Float
  stampsAwarded Int      @default(0)
  status        String
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  issuedBy      Staff    @relation(fields: [issuedById], references: [id])
  customer      Customer @relation(fields: [customerId], references: [id])
  merchant      Merchant @relation(fields: [merchantId], references: [id])
  stamps        Stamp[]

  @@index([merchantId])
  @@index([merchantId, customerId])
  @@index([merchantId, createdAt])
}

model Redemption {
  id           String   @id @default(cuid())
  merchantId   String
  customerId   String
  rewardId     String
  approvedById String?
  stampsSpent  Int
  status       String
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  approvedBy   Staff?   @relation(fields: [approvedById], references: [id])
  reward       Reward   @relation(fields: [rewardId], references: [id])
  customer     Customer @relation(fields: [customerId], references: [id])
  merchant     Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@index([merchantId, customerId])
}

model Referral {
  id                  String    @id @default(cuid())
  merchantId          String
  referrerId          String
  friendPhone         String
  friendCustomerId    String?
  status              String
  bonusStampsReferrer Int       @default(0)
  bonusStampsFriend   Int       @default(0)
  flaggedReason       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  friendCustomer      Customer? @relation("Friend", fields: [friendCustomerId], references: [id])
  referrer            Customer  @relation("Referrer", fields: [referrerId], references: [id])
  merchant            Merchant  @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@index([merchantId, status])
}

model WhatsAppMessage {
  id            String    @id @default(cuid())
  merchantId    String
  customerId    String?
  toPhone       String
  template      String
  body          String
  status        String
  metaMessageId String?
  sentAt        DateTime?
  errorMessage  String?
  deliveredAt   DateTime?
  readAt        DateTime?
  retryCount    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  scheduledFor  DateTime?
  customer      Customer? @relation(fields: [customerId], references: [id])
  merchant      Merchant  @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@index([merchantId, toPhone])
  @@index([metaMessageId])
  @@index([merchantId, status])
  @@index([status, scheduledFor])
}

model AuditLog {
  id         String   @id @default(cuid())
  merchantId String
  actorType  String
  actorId    String?
  staffId    String?
  action     String
  entity     String?
  entityId   String?
  metadata   String?
  createdAt  DateTime @default(now())
  staff      Staff?   @relation("StaffAuditLogs", fields: [staffId], references: [id])
  merchant   Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@index([merchantId, createdAt])
  @@index([merchantId, action])
}

model Plan {
  id              String         @id @default(cuid())
  planKey         String?        @unique
  name            String         @unique
  description     String?
  days            Int            @default(30)
  price           Float
  originalPrice   Float?
  discountPercent Int?           @default(0)
  badge           String?
  popular         Boolean        @default(false)
  currency        String         @default("INR")
  features        String
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  subscriptions   Subscription[]
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  description    String?
  discountType   String    @default("percent")
  discountValue  Float
  minOrderAmount Float?    @default(0)
  maxDiscount    Float?
  maxUses        Int?      @default(100)
  timesUsed      Int       @default(0)
  validUntil     DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([code])
  @@index([active])
}

model Subscription {
  id          String    @id @default(cuid())
  merchantId  String
  planId      String
  amount      Float
  currency    String    @default("INR")
  status      String
  renewalDate DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  plan        Plan      @relation(fields: [planId], references: [id])
  merchant    Merchant  @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
}

model Review {
  id                 String    @id @default(cuid())
  merchantId         String
  customerId         String
  platform           String?   @default("google")
  rating             Int
  aiDraft            String?
  finalText          String?
  photoUrl           String?
  status             String
  bonusStampsAwarded Int       @default(0)
  photoBonusStamps   Int       @default(0)
  requestSource      String?
  submittedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  customer           Customer  @relation(fields: [customerId], references: [id])
  merchant           Merchant  @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
}

model Birthday {
  id                String    @id @default(cuid())
  merchantId        String
  customerId        String
  birthMonth        Int
  birthDay          Int
  vipTier           String?
  rewardName        String
  bonusStamps       Int       @default(0)
  status            String
  rewardWindowStart DateTime?
  rewardWindowEnd   DateTime?
  reminderSentAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  customer          Customer  @relation(fields: [customerId], references: [id])
  merchant          Merchant  @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
}

model VipTier {
  id               String   @id @default(cuid())
  merchantId       String
  name             String
  minLifetimeSpend Float
  perks            String
  bonusMultiplier  Float    @default(1.0)
  color            String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  merchant         Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
}

model WinBackEscalation {
  id              String    @id @default(cuid())
  merchantId      String
  customerId      String
  stage           String
  action          String
  messageTemplate String
  sentAt          DateTime?
  outcome         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  customer        Customer  @relation(fields: [customerId], references: [id])
  merchant        Merchant  @relation(fields: [merchantId], references: [id])
}

model Achievement {
  id          String   @id @default(cuid())
  customerId  String
  type        String
  label       String
  description String?
  earnedAt    DateTime @default(now())
  customer    Customer @relation(fields: [customerId], references: [id])
}

model SupportTicket {
  id          String    @id @default(cuid())
  merchantId  String
  subject     String
  category    String
  priority    String
  status      String
  description String?
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  merchant    Merchant  @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
}

model OnboardingStep {
  id          String    @id @default(cuid())
  merchantId  String
  stepKey     String
  label       String?
  completed   Boolean   @default(false)
  skipped     Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  merchant    Merchant  @relation(fields: [merchantId], references: [id])
}

model WaitingCustomer {
  id                   String    @id @default(cuid())
  merchantId           String
  customerId           String
  status               String
  scannedAt            DateTime  @default(now())
  claimedAt            DateTime?
  claimedById          String?
  amount               Float?
  stampsAwarded        Int?
  expiresAt            DateTime
  scanSource           String?
  reservedAt           DateTime?
  reservedById         String?
  reservationExpiresAt DateTime?
  undoWindowUntil      DateTime?
  recoveredAt          DateTime?
  recoveredById        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  recoveredBy          Staff?    @relation("RecoveredBy", fields: [recoveredById], references: [id])
  reservedBy           Staff?    @relation("ReservedBy", fields: [reservedById], references: [id])
  claimedBy            Staff?    @relation("ClaimedBy", fields: [claimedById], references: [id])
  customer             Customer  @relation(fields: [customerId], references: [id])
  merchant             Merchant  @relation(fields: [merchantId], references: [id])

  @@index([merchantId, status])
  @@index([merchantId, customerId])
}

model FraudAlert {
  id         String   @id @default(cuid())
  merchantId String
  createdAt  DateTime @default(now())
  merchant   Merchant @relation(fields: [merchantId], references: [id])
}

model CustomerMergeLog {
  id         String   @id @default(cuid())
  merchantId String
  createdAt  DateTime @default(now())
  merchant   Merchant @relation(fields: [merchantId], references: [id])
}

model MerchantTransferLog {
  id               String   @id @default(cuid())
  merchantId       String
  oldOwnerId       String?
  legalAttestation Boolean?
  createdAt        DateTime @default(now())
  merchant         Merchant @relation(fields: [merchantId], references: [id])
}

model RewardWaitlist {
  id         String   @id @default(cuid())
  merchantId String
  createdAt  DateTime @default(now())
  merchant   Merchant @relation(fields: [merchantId], references: [id])
}

model CardRuleChangeLog {
  id         String   @id @default(cuid())
  merchantId String
  createdAt  DateTime @default(now())
  merchant   Merchant @relation(fields: [merchantId], references: [id])
}

model CampaignDeliveryLog {
  id         String   @id @default(cuid())
  merchantId String
  createdAt  DateTime @default(now())
  merchant   Merchant @relation(fields: [merchantId], references: [id])
}

model OwnerOverrideLog {
  id           String   @id @default(cuid())
  merchantId   String
  ownerStaffId String?
  customerId   String?
  monthKey     String?
  overrideType String?
  createdAt    DateTime @default(now())
  merchant     Merchant @relation(fields: [merchantId], references: [id])
}

model MerchantGoogleConnection {
  id                String    @id @default(cuid())
  merchantId        String    @unique
  placeId           String?
  placeName         String?
  address           String?
  verified          Boolean   @default(false)
  syncStatus        String?
  lastSyncedAt      DateTime?
  createdAt         DateTime  @default(now())
  connectionType    String?   @default("oauth")
  gbpAccountId      String?
  gbpLocationId     String?
  googleReviewUrl   String?
  oauthAccessToken  String?
  oauthRefreshToken String?
  oauthTokenExpiry  DateTime?
  merchant          Merchant  @relation(fields: [merchantId], references: [id])
}

model OTPSession {
  id             String   @id @default(cuid())
  phone          String
  otp            String
  messageId      String?
  verified       Boolean  @default(false)
  deliveryStatus String?
  attempts       Int      @default(0)
  maxAttempts    Int      @default(3)
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([phone])
  @@index([expiresAt])
}

model DeadLetterQueue {
  id            String    @id @default(cuid())
  merchantId    String?
  originalTable String?
  originalId    String?
  payload       String
  error         String?
  errorReason   String?
  retryCount    Int       @default(0)
  willExpireAt  DateTime?
  createdAt     DateTime  @default(now())
}

model GoogleBusinessReview {
  id           String    @id @default(cuid())
  merchantId   String
  gbpReviewId  String
  reviewerName String
  rating       Int
  comment      String?
  reviewReply  String?
  isReplied    Boolean   @default(false)
  repliedAt    DateTime?
  status       String    @default("pending")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  merchant     Merchant  @relation(fields: [merchantId], references: [id])

  @@unique([merchantId, gbpReviewId])
}

model BackgroundJob {
  id          String    @id @default(cuid())
  merchantId  String
  type        String
  status      String    @default("pending")
  totalItems  Int       @default(0)
  processed   Int       @default(0)
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  merchant    Merchant  @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
}

model SystemContent {
  id        String   @id @default(cuid())
  section   String
  key       String   @unique
  value     String
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MessageTemplate {
  id           String                   @id @default(cuid())
  merchantId   String?
  templateKey  String
  templateName String
  triggerEvent String
  category     String                   @default("MARKETING")
  messageBody  String
  language     String                   @default("en")
  variables    String
  enabled      Boolean                  @default(true)
  version      Int                      @default(1)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  createdBy    String?
  updatedBy    String?
  merchant     Merchant?                @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  history      TemplateVersionHistory[]

  @@unique([merchantId, templateKey, language])
  @@index([merchantId])
  @@index([templateKey])
}

model TemplateVersionHistory {
  id           String          @id @default(cuid())
  templateId   String
  version      Int
  messageBody  String
  changedBy    String?
  changeReason String?
  createdAt    DateTime        @default(now())
  template     MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

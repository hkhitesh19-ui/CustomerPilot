generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  password  String?
  role      String    @default("merchant")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  merchant  Merchant?
}

model Merchant {
  id                        String                    @id @default(cuid())
  merchantIdNumber          String?                   @unique
  userId                    String?                   @unique
  name                      String
  businessType              String?
  ownerName                 String?
  address                   String?
  businessTiming            String?
  category                  String?
  city                      String?
  googleReviewLink          String?
  baselineReviewCount       Int?                      @default(0)
  baselineRating            Float?                    @default(0.0)
  baselineScreenshotUrl     String?
  baselineCapturedAt        DateTime?
  timezone                  String?
  whatsappPhone             String?                   @unique
  whatsappInstanceName      String?
  email                     String?
  logoUrl                   String?
  coverUrl                  String?
  plan                      String?                   @default("trial")
  status                    String?                   @default("active")
  trialEndsAt               DateTime?
  onboardingCompleted       Boolean                   @default(false)
  currentStep               Int                       @default(1)
  googleReviewDelayMinutes  Int                       @default(30)
  vipUpgradeBonusStamps     Int                       @default(1)
  loyaltyCategoryNames      String?
  winbackDays1              Int                       @default(30)
  winbackDays2              Int                       @default(60)
  winbackDays3              Int                       @default(90)
  expiryWarningDays         Int                       @default(7)
  almostThereInactivityDays Int                       @default(7)
  enabledModules            String                    @default("LOYALTY,REVIEWS,AUTOREPLY")
  // Growth Engine fields
  showPoweredBy             Boolean                   @default(true)
  ctaEnabled                Boolean                   @default(true)
  merchantReferralCode      String?                   @unique
  walletCredit              Int                       @default(0)
  communityUrl              String?
  // --- GBP Service Track Fields ---
  // Track A = "New Business Launchpad" | Track B = "Top 3 Rank Accelerator"
  gbpServiceTrack           String?                   @default("NONE")
  // Values: "NONE" | "TRACK_A_NEW" | "TRACK_B_EXISTING"
  gbpProfileStatus          String?                   @default("UNVERIFIED")
  // Values: "UNVERIFIED" | "SANDBOX" | "VERIFIED" | "TOP3_LOCKED"
  gbpOnboardingWeek         Int?                      @default(0)
  // 0 = not started, 1-8 = active week number
  gbpReviewCount            Int?                      @default(0)
  // Running total of GBP reviews received via CustomerPilot
  gbpReviewVelocityCap      Int?                      @default(3)
  // Max reviews/week allowed: Track A = 3/week, Track B = 10/week
  gbpCitationsReady         Boolean?                  @default(false)
  // Has exec confirmed NAP citations on JD/Sulekha/FB/Insta
  gbpSurgeryCompleted       Boolean?                  @default(false)
  // Track B: Has 90-min Day 1-5 GBP surgery been completed
  gbpMapTrafficEnabled      Boolean?                  @default(false)
  // Track B: Weekend Map Traffic broadcast active for CTR booster
  gbpLastReportSentAt       DateTime?
  // Timestamp of last monthly GBP WhatsApp report sent
  gbpTrackStartedAt         DateTime?
  // When GBP track first assigned - used to compute 30-day sandbox unlock
  gbpChecklistItems         GbpChecklistItem[]
  gbpPosts                  GbpPost[]
  gbpAuditReports           GbpAuditReport[]
  gbpKeywordDailyRanks      GbpKeywordDailyRank[]
  trackedKeywords           MerchantTrackedKeyword[]
  geoGridScans              GbpGeoGridScan[]

  // Smart Keyword Control Engine & Grounding JSON Profile
  keywordProfile            String?
  // ---
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  auditLogs                 AuditLog[]
  backgroundJobs            BackgroundJob[]
  bills                     Bill[]
  birthdays                 Birthday[]
  campaignDeliveryLogs      CampaignDeliveryLog[]
  cardRuleChangeLogs        CardRuleChangeLog[]
  customers                 Customer[]
  customerMergeLogs         CustomerMergeLog[]
  customerStampCards        CustomerStampCard[]
  fraudAlerts               FraudAlert[]
  googleBusinessReviews     GoogleBusinessReview[]
  growthReports             GrowthReport[]
  growthSnapshots           GrowthSnapshot[]
  incidents                 Incident[]
  user                      User?                     @relation(fields: [userId], references: [id])
  merchantGoogleConnections MerchantGoogleConnection?
  merchantReferralsMade     MerchantReferral[]        @relation("MerchantReferrer")
  merchantReferralsReceived MerchantReferral[]        @relation("MerchantReferred")
  merchantTransferLogs      MerchantTransferLog[]
  messageTemplates          MessageTemplate[]
  onboardingSteps           OnboardingStep[]
  ownerOverrideLogs         OwnerOverrideLog[]
  redemptions               Redemption[]
  referrals                 Referral[]
  reviews                   Review[]
  reviewBonusLogs           ReviewBonusLog[]
  rewards                   Reward[]
  rewardWaitlists           RewardWaitlist[]
  staff                     Staff[]
  Stamp                     Stamp[]
  stampCards                StampCard[]
  subscriptions             Subscription[]
  supportTickets            SupportTicket[]
  vipTiers                  VipTier[]
  waitingCustomers          WaitingCustomer[]
  whatsAppMessages          WhatsAppMessage[]
  winBackEscalations        WinBackEscalation[]
  menuItems                 MenuItem[]
  orders                    Order[]
  digitalBusinessCard       DigitalBusinessCard?
  qrCodes                   QrCode[]
  invoices                  Invoice[]
  customerConsents          CustomerConsent[]
}

model Incident {
  id         String    @id @default(cuid())
  incidentNo String    @unique
  merchantId String?
  severity   String    @default("MEDIUM")
  title      String
  rootCause  String?
  resolution String?
  status     String    @default("OPEN")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  merchant   Merchant? @relation(fields: [merchantId], references: [id])

  @@index([status])
  @@index([createdAt])
}

model Staff {
  id                          String            @id @default(cuid())
  merchantId                  String
  name                        String
  email                       String?
  phone                       String?
  pin                         String?
  role                        String
  requireManagerApprovalUntil DateTime?
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt
  auditLogs                   AuditLog[]        @relation("StaffAuditLogs")
  billsIssued                 Bill[]
  redemptionsApproved         Redemption[]
  merchant                    Merchant          @relation(fields: [merchantId], references: [id])
  waitingCustomersRecovered   WaitingCustomer[] @relation("RecoveredBy")
  waitingCustomersReserved    WaitingCustomer[] @relation("ReservedBy")
  waitingCustomersClaimed     WaitingCustomer[] @relation("ClaimedBy")

  @@index([merchantId])
}

model Customer {
  id                  String              @id @default(cuid())
  merchantId          String
  name                String
  email               String?
  phone               String
  referralCode        String?
  acquisitionChan     String?
  notes               String?
  lifetimeStamps      Int                 @default(0)
  lifetimeSpend       Float               @default(0)
  lifetimeRedemptions Int                 @default(0)
  currentStreak       Int                 @default(0)
  longestStreak       Int                 @default(0)
  birthday            String?
  favorite            Boolean             @default(false)
  vipTier             String?             @default("none")
  botState            String              @default("IDLE")
  botStateUpdatedAt   DateTime            @default(now())
  lastActiveAt        DateTime?
  status              String?
  whatsappOptIn       Boolean             @default(true)
  walletCredit        Int                 @default(0)
  referredById        String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  deletedAt           DateTime?           // Soft-delete: set instead of hard delete
  achievements        Achievement[]
  bills               Bill[]
  birthdaysList       Birthday[]
  referredBy          Customer?           @relation("CustomerReferrals", fields: [referredById], references: [id])
  referralsMade       Customer[]          @relation("CustomerReferrals")
  merchant            Merchant            @relation(fields: [merchantId], references: [id])
  stampCards          CustomerStampCard[]
  redemptions         Redemption[]
  referralsReceived   Referral[]          @relation("Friend")
  referrals           Referral[]          @relation("Referrer")
  reviews             Review[]
  reviewBonusLogs     ReviewBonusLog[]
  stamps              Stamp[]
  waitingCustomers    WaitingCustomer[]
  whatsAppMessages    WhatsAppMessage[]
  winBackEscalations  WinBackEscalation[]
  orders              Order[]
  invoices            Invoice[]
  customerConsents    CustomerConsent[]

  @@unique([merchantId, phone])
  @@index([merchantId])
  @@index([merchantId, phone])
  @@index([merchantId, status])
  @@index([merchantId, lastActiveAt])
  @@index([merchantId, deletedAt])
}

model StampCard {
  id                 String              @id @default(cuid())
  merchantId         String
  name               String
  stampsRequired     Int
  rewardName         String
  stampsPerBill      String?
  color              String?
  rewardImageUrl     String?
  stampValue         Float?
  validityDays       Int?
  googleReviewBonus  Int?
  photoBonus         Int?
  joiningBonusEnabled Boolean            @default(true)
  joiningBonusStamps  Int                @default(2)
  tierRewardsEnabled Boolean             @default(false)
  excludedCategories String?
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  customerCards      CustomerStampCard[]
  stamps             Stamp[]
  merchant           Merchant            @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
}

model CustomerStampCard {
  id              String    @id @default(cuid())
  customerId      String
  stampCardId     String
  merchantId      String
  stampsCollected Int       @default(0)
  completed       Boolean   @default(false)
  redeemed        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  merchant        Merchant  @relation(fields: [merchantId], references: [id])
  stampCard       StampCard @relation(fields: [stampCardId], references: [id])
  customer        Customer  @relation(fields: [customerId], references: [id])
  stamps          Stamp[]

  @@index([customerId, stampCardId])
  @@index([merchantId])
}

model Stamp {
  id                  String             @id @default(cuid())
  customerId          String
  stampCardId         String?
  customerStampCardId String?
  merchantId          String
  source              String
  billId              String?
  createdAt           DateTime           @default(now())
  deletedAt           DateTime?          // Soft-delete: set instead of hard delete
  bill                Bill?              @relation(fields: [billId], references: [id])
  merchant            Merchant           @relation(fields: [merchantId], references: [id])
  customerStampCard   CustomerStampCard? @relation(fields: [customerStampCardId], references: [id])
  stampCard           StampCard?         @relation(fields: [stampCardId], references: [id])
  customer            Customer           @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([merchantId])
}

model Reward {
  id                      String       @id @default(cuid())
  merchantId              String
  name                    String
  description             String?
  stampsCost              Int
  stock                   Int          @default(0)
  active                  Boolean      @default(true)
  requiresManagerApproval Boolean      @default(false)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  deletedAt               DateTime?    // Soft-delete: set instead of hard delete
  redemptions             Redemption[]
  merchant                Merchant     @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
}

model Bill {
  id            String   @id @default(cuid())
  merchantId    String
  customerId    String
  issuedById    String
  number        String
  amount        Float
  stampsAwarded Int      @default(0)
  status        String
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  issuedBy      Staff    @relation(fields: [issuedById], references: [id])
  customer      Customer @relation(fields: [customerId], references: [id])
  merchant      Merchant @relation(fields: [merchantId], references: [id])
  stamps        Stamp[]

  @@index([merchantId])
  @@index([merchantId, customerId])
  @@index([merchantId, createdAt])
}

model Redemption {
  id           String   @id @default(cuid())
  merchantId   String
  customerId   String
  rewardId     String
  approvedById String?
  stampsSpent  Int
  status       String
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  approvedBy   Staff?   @relation(fields: [approvedById], references: [id])
  reward       Reward   @relation(fields: [rewardId], references: [id])
  customer     Customer @relation(fields: [customerId], references: [id])
  merchant     Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@index([merchantId, customerId])
}

model Referral {
  id                  String    @id @default(cuid())
  merchantId          String
  referrerId          String
  friendPhone         String
  friendCustomerId    String?
  status              String
  bonusStampsReferrer Int       @default(0)
  bonusStampsFriend   Int       @default(0)
  rewardType          String?   // "stamps" | "credit" | "coupon"
  rewardAmount        Int       @default(50)
  qualifyingEvent     String?   // "QUALIFYING_PURCHASE"
  flaggedReason       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  friendCustomer      Customer? @relation("Friend", fields: [friendCustomerId], references: [id])
  referrer            Customer  @relation("Referrer", fields: [referrerId], references: [id])
  merchant            Merchant  @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@index([merchantId, status])
}

model WhatsAppMessage {
  id            String    @id @default(cuid())
  merchantId    String
  customerId    String?
  toPhone       String
  template      String
  body          String
  status        String
  metaMessageId String?
  sentAt        DateTime?
  errorMessage  String?
  deliveredAt   DateTime?
  readAt        DateTime?
  retryCount    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  scheduledFor  DateTime?
  customer      Customer? @relation(fields: [customerId], references: [id])
  merchant      Merchant  @relation(fields: [merchantId], references: [id])
  invoiceId     String?
  idempotencyKey String?   @unique
  invoice       Invoice?  @relation("InvoiceWAMessages", fields: [invoiceId], references: [id])

  @@index([merchantId])
  @@index([merchantId, toPhone])
  @@index([metaMessageId])
  @@index([merchantId, status])
  @@index([status, scheduledFor])
}

model AuditLog {
  id         String   @id @default(cuid())
  merchantId String
  actorType  String
  actorId    String?
  staffId    String?
  action     String
  entity     String?
  entityId   String?
  metadata   String?
  createdAt  DateTime @default(now())
  staff      Staff?   @relation("StaffAuditLogs", fields: [staffId], references: [id])
  merchant   Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@index([merchantId, createdAt])
  @@index([merchantId, action])
}

model Plan {
  id              String         @id @default(cuid())
  planKey         String?        @unique
  name            String         @unique
  description     String?
  days            Int            @default(30)
  price           Float
  originalPrice   Float?
  discountPercent Int?           @default(0)
  badge           String?
  popular         Boolean        @default(false)
  currency        String         @default("INR")
  features        String
  enabledModules  String         @default("LOYALTY,REVIEWS,AUTOREPLY")
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  subscriptions   Subscription[]
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  description    String?
  discountType   String    @default("percent")
  discountValue  Float
  minOrderAmount Float?    @default(0)
  maxDiscount    Float?
  maxUses        Int?      @default(100)
  timesUsed      Int       @default(0)
  validUntil     DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([code])
  @@index([active])
}

model Subscription {
  id          String    @id @default(cuid())
  merchantId  String
  planId      String
  amount      Float
  currency    String    @default("INR")
  status      String
  renewalDate DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  plan        Plan      @relation(fields: [planId], references: [id])
  merchant    Merchant  @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
}

model Review {
  id                 String    @id @default(cuid())
  merchantId         String
  customerId         String
  platform           String?   @default("google")
  rating             Int
  aiDraft            String?
  finalText          String?
  photoUrl           String?
  status             String
  bonusStampsAwarded Int       @default(0)
  photoBonusStamps   Int       @default(0)
  requestSource      String?
  submittedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  customer           Customer  @relation(fields: [customerId], references: [id])
  merchant           Merchant  @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
}

model Birthday {
  id                String    @id @default(cuid())
  merchantId        String
  customerId        String
  birthMonth        Int
  birthDay          Int
  vipTier           String?
  rewardName        String
  bonusStamps       Int       @default(0)
  status            String
  rewardWindowStart DateTime?
  rewardWindowEnd   DateTime?
  reminderSentAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  customer          Customer  @relation(fields: [customerId], references: [id])
  merchant          Merchant  @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
}

model VipTier {
  id               String   @id @default(cuid())
  merchantId       String
  name             String
  minLifetimeSpend Float
  perks            String
  bonusMultiplier  Float    @default(1.0)
  color            String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  merchant         Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
}

model WinBackEscalation {
  id              String    @id @default(cuid())
  merchantId      String
  customerId      String
  stage           String
  action          String
  messageTemplate String
  sentAt          DateTime?
  outcome         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  customer        Customer  @relation(fields: [customerId], references: [id])
  merchant        Merchant  @relation(fields: [merchantId], references: [id])
}

model Achievement {
  id          String   @id @default(cuid())
  customerId  String
  type        String
  label       String
  description String?
  earnedAt    DateTime @default(now())
  customer    Customer @relation(fields: [customerId], references: [id])
}

model SupportTicket {
  id          String    @id @default(cuid())
  merchantId  String
  subject     String
  category    String
  priority    String
  status      String
  description String?
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  merchant    Merchant  @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
}

model OnboardingStep {
  id          String    @id @default(cuid())
  merchantId  String
  stepKey     String
  label       String?
  completed   Boolean   @default(false)
  skipped     Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  merchant    Merchant  @relation(fields: [merchantId], references: [id])
}

model WaitingCustomer {
  id                   String    @id @default(cuid())
  merchantId           String
  customerId           String
  status               String
  scannedAt            DateTime  @default(now())
  claimedAt            DateTime?
  claimedById          String?
  amount               Float?
  stampsAwarded        Int?
  expiresAt            DateTime
  scanSource           String?
  reservedAt           DateTime?
  reservedById         String?
  reservationExpiresAt DateTime?
  undoWindowUntil      DateTime?
  recoveredAt          DateTime?
  recoveredById        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  recoveredBy          Staff?    @relation("RecoveredBy", fields: [recoveredById], references: [id])
  reservedBy           Staff?    @relation("ReservedBy", fields: [reservedById], references: [id])
  claimedBy            Staff?    @relation("ClaimedBy", fields: [claimedById], references: [id])
  customer             Customer  @relation(fields: [customerId], references: [id])
  merchant             Merchant  @relation(fields: [merchantId], references: [id])

  @@index([merchantId, status])
  @@index([merchantId, customerId])
}

model FraudAlert {
  id         String   @id @default(cuid())
  merchantId String
  createdAt  DateTime @default(now())
  merchant   Merchant @relation(fields: [merchantId], references: [id])
}

model CustomerMergeLog {
  id         String   @id @default(cuid())
  merchantId String
  createdAt  DateTime @default(now())
  merchant   Merchant @relation(fields: [merchantId], references: [id])
}

model MerchantTransferLog {
  id               String   @id @default(cuid())
  merchantId       String
  oldOwnerId       String?
  legalAttestation Boolean?
  createdAt        DateTime @default(now())
  merchant         Merchant @relation(fields: [merchantId], references: [id])
}

model RewardWaitlist {
  id         String   @id @default(cuid())
  merchantId String
  createdAt  DateTime @default(now())
  merchant   Merchant @relation(fields: [merchantId], references: [id])
}

model CardRuleChangeLog {
  id         String   @id @default(cuid())
  merchantId String
  createdAt  DateTime @default(now())
  merchant   Merchant @relation(fields: [merchantId], references: [id])
}

model CampaignDeliveryLog {
  id         String   @id @default(cuid())
  merchantId String
  createdAt  DateTime @default(now())
  merchant   Merchant @relation(fields: [merchantId], references: [id])
}

model OwnerOverrideLog {
  id           String   @id @default(cuid())
  merchantId   String
  ownerStaffId String?
  customerId   String?
  monthKey     String?
  overrideType String?
  createdAt    DateTime @default(now())
  merchant     Merchant @relation(fields: [merchantId], references: [id])
}

model MerchantGoogleConnection {
  id                String    @id @default(cuid())
  merchantId        String    @unique
  placeId           String?
  placeName         String?
  address           String?
  verified          Boolean   @default(false)
  syncStatus        String?
  lastSyncedAt      DateTime?
  createdAt         DateTime  @default(now())
  connectionType    String?   @default("oauth")
  gbpAccountId      String?
  gbpLocationId     String?
  googleReviewUrl   String?
  oauthAccessToken  String?
  oauthRefreshToken String?
  oauthTokenExpiry  DateTime?
  merchant          Merchant  @relation(fields: [merchantId], references: [id])
}

model OTPSession {
  id             String   @id @default(cuid())
  phone          String
  otp            String
  messageId      String?
  verified       Boolean  @default(false)
  deliveryStatus String?
  attempts       Int      @default(0)
  maxAttempts    Int      @default(3)
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([phone])
  @@index([expiresAt])
}

model DeadLetterQueue {
  id            String    @id @default(cuid())
  merchantId    String?
  originalTable String?
  originalId    String?
  payload       String
  error         String?
  errorReason   String?
  retryCount    Int       @default(0)
  willExpireAt  DateTime?
  createdAt     DateTime  @default(now())
}

model GoogleBusinessReview {
  id           String    @id @default(cuid())
  merchantId   String
  gbpReviewId  String
  reviewerName String
  rating       Int
  comment      String?
  reviewReply  String?
  isReplied    Boolean   @default(false)
  repliedAt    DateTime?
  status       String    @default("pending")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  merchant     Merchant  @relation(fields: [merchantId], references: [id])

  @@unique([merchantId, gbpReviewId])
}

model BackgroundJob {
  id          String    @id @default(cuid())
  merchantId  String
  type        String
  status      String    @default("pending")
  totalItems  Int       @default(0)
  processed   Int       @default(0)
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  merchant    Merchant  @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
}

model SystemContent {
  id        String   @id @default(cuid())
  section   String
  key       String   @unique
  value     String
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MessageTemplate {
  id           String                   @id @default(cuid())
  merchantId   String?
  templateKey  String
  templateName String
  triggerEvent String
  category     String                   @default("MARKETING")
  messageBody  String
  language     String                   @default("en")
  variables    String
  enabled      Boolean                  @default(true)
  version      Int                      @default(1)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  createdBy    String?
  updatedBy    String?
  merchant     Merchant?                @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  history      TemplateVersionHistory[]

  @@unique([merchantId, templateKey, language])
  @@index([merchantId])
  @@index([templateKey])
}

model TemplateVersionHistory {
  id           String          @id @default(cuid())
  templateId   String
  version      Int
  messageBody  String
  changedBy    String?
  changeReason String?
  createdAt    DateTime        @default(now())
  template     MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

// ─── Growth Engine Models ────────────────────────────────────────

model MerchantReferral {
  id                  String    @id @default(cuid())
  referrerMerchantId  String
  referredMerchantId  String?
  referralCode        String    @unique
  referredEmail       String?
  referredPhone       String?
  status              String    @default("INVITED") // INVITED | SIGNED_UP | ACTIVATED | PAID | REWARDED
  referrerReward      Int       @default(100)
  referredReward      Int       @default(100)
  qualifyingEvent     String?   // "first_paid_subscription"
  createdAt           DateTime  @default(now())
  convertedAt         DateTime?
  rewardedAt          DateTime?
  updatedAt           DateTime  @updatedAt
  referrerMerchant    Merchant  @relation("MerchantReferrer", fields: [referrerMerchantId], references: [id])
  referredMerchant    Merchant? @relation("MerchantReferred", fields: [referredMerchantId], references: [id])

  @@index([referrerMerchantId])
  @@index([referralCode])
  @@index([status])
}

model GrowthSnapshot {
  id               String   @id @default(cuid())
  merchantId       String
  snapshotDate     DateTime
  totalCustomers   Int      @default(0)
  totalStamps      Int      @default(0)
  totalRedemptions Int      @default(0)
  totalReviews     Int      @default(0)
  repeatVisits     Int      @default(0)
  googleReviewCount Int     @default(0)
  createdAt        DateTime @default(now())
  merchant         Merchant @relation(fields: [merchantId], references: [id])

  @@unique([merchantId, snapshotDate])
  @@index([merchantId])
}

model GrowthReport {
  id              String    @id @default(cuid())
  merchantId      String
  reportMonth     String    // "2026-08"
  periodStart     DateTime
  periodEnd       DateTime
  newCustomers    Int       @default(0)
  stampsIssued    Int       @default(0)
  rewardsRedeemed Int       @default(0)
  reviewsReceived Int       @default(0)
  repliesPosted   Int       @default(0)
  repeatVisits    Int       @default(0)
  shareImageUrl   String?
  sharedAt        DateTime?
  createdAt       DateTime  @default(now())
  merchant        Merchant  @relation(fields: [merchantId], references: [id])

  @@unique([merchantId, reportMonth])
  @@index([merchantId])
}

model ReviewBonusLog {
  id                String    @id @default(cuid())
  merchantId        String
  customerId        String
  reviewId          String?   // Local Review ID or GBP reviewId
  reviewerName      String
  stage             String    // "INITIAL_REVIEW" | "GBP_DIRECT" | "GBP_CUSTOMER_MEDIA" | "FAILSAFE" | "RETROACTIVE"
  photoUri          String?
  matchConfidence   Float?
  decision          String    // "2_STAMPS" | "4_STAMPS" | "PENDING"
  reason            String
  recheckScheduled  Boolean   @default(false)
  recheckAt         DateTime?
  retryCount        Int       @default(0)
  finalizedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([merchantId, customerId, createdAt])
  @@index([decision, recheckAt])
}

model DigitalBusinessCard {
  id               String    @id @default(cuid())
  merchantId       String    @unique
  slug             String    @unique
  isActive         Boolean   @default(true)
  
  // Theme & Appearance
  theme            String    @default("champagne_luxury")
  
  // Business Identity
  displayName      String
  subCategories    String?   // e.g. "Cakes • Desserts • Flowers • Party Decor"
  logoUrl          String?
  coverUrl         String?
  
  // 3-Pill Quick Status Bar
  locationShort    String?   // "Manjalpur, Vadodara"
  locationState    String?   // "Gujarat, India"
  businessHours    String?   // "Open Daily: 9:00 AM – 12:00 AM"
  deliveryInfo     String?   // "Delivery Available: Vadodara Only"
  
  // Contact & Social Media Links
  whatsappNumber   String?   // "919876543210"
  phoneNumber      String?   // "+91 98765 43210"
  instagramUrl     String?
  facebookUrl      String?
  youtubeUrl       String?
  googleMapsUrl    String?
  websiteUrl       String?
  
  // Online Ordering Platforms (JSON array string)
  orderingLinks    String?   @default("[]")
  
  // Live Google Reviews Widget
  googleRating     Float?    @default(4.6)
  googleReviewsCnt Int?      @default(689)
  googlePlaceId    String?
  
  // Analytics
  viewsCount       Int       @default(0)
  contactSaves     Int       @default(0)
  sharesCount      Int       @default(0)

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  merchant         Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([slug])
  @@index([merchantId])
}

model GbpChecklistItem {
  id          String    @id @default(cuid())
  merchantId  String
  track       String    // "TRACK_A_NEW" | "TRACK_B_EXISTING"
  week        Int       // Week/Phase number (1-8 for A, 1-3 for B)
  taskKey     String    // e.g. "SIGNBOARD_VERIFIED", "CITATIONS_DONE"
  taskLabel   String
  isDone      Boolean   @default(false)
  doneAt      DateTime?
  doneByEmail String?   // Operations executive email who completed it
  notes       String?
  createdAt   DateTime  @default(now())
  merchant    Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([track, week])
  @@index([merchantId, isDone])
}

model GbpPost {
  id             String    @id @default(cuid())
  merchantId     String
  postType       String    // "PRODUCT_SPOTLIGHT" | "SOCIAL_PROOF" | "WEEKEND_OFFER"
  scheduledDay   String    // "TUESDAY" | "THURSDAY" | "SATURDAY"
  scheduledDate  DateTime
  title          String?
  caption        String
  imageUrl       String
  ctaType        String?   // "ORDER" | "CALL" | "OFFER" | "LEARN_MORE"
  ctaUrl         String?
  couponCode     String?
  offerStartDate DateTime?
  offerEndDate   DateTime?
  status         String    @default("AWAITING_APPROVAL") // "DRAFT" | "AWAITING_APPROVAL" | "APPROVED" | "QUEUED" | "POSTED" | "REJECTED" | "FAILED"
  merchantFeedback String?
  approvedAt     DateTime?
  rejectedAt     DateTime?
  revisionCount  Int       @default(0)
  postedAt       DateTime?
  postedBy       String?   // "API" | "OPERATOR"
  gbpPostId      String?   // Google localPost resource name if posted via API
  errorMessage   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  merchant       Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([status, scheduledDate])
  @@index([merchantId, postType])
}

model GbpAuditReport {
  id                    String    @id @default(cuid())
  merchantId            String
  reportType            String    @default("DAY_0_BASELINE") // "DAY_0_BASELINE" | "MONTHLY_30_DAY"
  reportPeriod          String    // e.g. "DAY_0", "2026-11", "2026-12"
  daysSinceOnboarding   Int       @default(0)
  rankScore             Int       @default(0) // Overall Audit Score 0-100
  currentRank           Int       @default(0) // Detected Rank in primary keyword
  baselineRank          Int       @default(0) // Baseline rank at day 0
  totalReviews          Int       @default(0)
  starRating            Float     @default(0.0)
  gridScore             Int       @default(1) // 1 to 9
  primaryKeyword        String?
  locality              String?
  competitorsJson       String?   // Serialized JSON of competitors
  revenueLeakEst        Float     @default(0.0)
  screenshotUrl         String?   // Real-time snapshot of Google Maps / SERP
  reportSummary         String?   // Diagnostic findings / AI insights
  actionItemsJson       String?   // Recommended sprint actions
  pdfDownloadUrl        String?   // Exportable report URL
  isDeliveredWhatsApp   Boolean   @default(false)
  deliveredAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  merchant              Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, reportType, reportPeriod])
  @@index([merchantId])
}


model GbpKeywordDailyRank {
  id            String   @id @default(cuid())
  merchantId    String
  keyword       String
  keywordType   String   @default("SEO") // "GEO" | "SEO" | "AEO"
  rankPosition  Int      @default(0)     // 1 to 50 (or 0 for unranked >50)
  previousRank  Int      @default(0)     // Previous day rank for delta calculation
  searchVolume  Int      @default(0)     // Estimated monthly searches
  locality      String?                  // E.g. "Manjalpur", "Eva Mall", "Vadodara"
  targetCity    String   @default("Vadodara")
  serpFeature   String?  @default("LOCAL_3PACK") // "LOCAL_3PACK" | "ORGANIC" | "AI_OVERVIEW" | "KNOWLEDGE_PANEL"
  snapshotDate  String                   // Format: "YYYY-MM-DD"
  capturedAt    DateTime @default(now())

  merchant      Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, keyword, snapshotDate])
  @@index([merchantId, snapshotDate])
  @@index([merchantId, keywordType])
}

model MerchantTrackedKeyword {
  id                 String    @id @default(cuid())
  merchantId         String
  keyword            String
  keywordType        String    @default("SEO") // "GEO" | "SEO" | "AEO"
  targetLocality     String?                   // e.g. "Manjalpur", "Eva Mall"
  targetCity         String    @default("Vadodara")
  searchVolume       Int       @default(500)
  serpFeature        String    @default("LOCAL_3PACK") // "LOCAL_3PACK" | "ORGANIC" | "AI_OVERVIEW" | "KNOWLEDGE_PANEL"
  baselineRank       Int       @default(10)
  isActive           Boolean   @default(true)
  // Module 6: 10-Keyword Weighted Portfolio
  isPortfolioTarget  Boolean   @default(false)
  portfolioCategory  String?   // "OPPORTUNITY" | "HIGH_VALUE" | "STRATEGIC"
  commercialScore    Float     @default(0) // 0 to 100
  relevanceScore     Int       @default(25) // 0-25 (25%)
  intentScore        Int       @default(25) // 0-25 (25%)
  demandScore        Int       @default(15) // 0-15 (15%)
  opportunityScore   Int       @default(15) // 0-15 (15%)
  profitabilityScore Int       @default(10) // 0-10 (10%)
  competitionScore   Int       @default(10) // 0-10 (10%)
  portfolioLockedAt  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  merchant           Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, keyword])
  @@index([merchantId, isActive])
  @@index([merchantId, keywordType])
  @@index([merchantId, isPortfolioTarget])
}

model GbpGeoGridScan {
  id               String   @id @default(cuid())
  merchantId       String
  keyword          String
  centerLat        Float    @default(22.2785)
  centerLng        Float    @default(73.1950)
  radiusKm         Float    @default(5.0)
  gridSize         Int      @default(5) // 5x5 = 25 points
  top3CoveragePct  Float    @default(0) // e.g. 64%
  top10CoveragePct Float    @default(0) // e.g. 88%
  avgRank          Float    @default(0)
  pointsJson       String   // JSON array string of 25 coordinate points
  scannedAt        DateTime @default(now())

  merchant         Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, keyword])
  @@index([merchantId, scannedAt])
}

model ReviewVerificationLog {
  id                 String   @id @default(cuid())
  merchantId         String
  customerPhone      String
  imageSha256Hash    String   @unique
  reviewFingerprint  String   @unique
  reviewerName       String?
  extractedText      String?
  starRating         Int
  hasKeywordMatch    Boolean  @default(false)
  hasPhotoAttached   Boolean  @default(false)
  stampsCredited     Int      @default(1)
  status             String   // "APPROVED" | "REJECTED"
  rejectionReason    String?
  createdAt          DateTime @default(now())

  @@index([merchantId, customerPhone])
}


// ─────────────────────────────────────────────────────────────────────────────
// WHATSAPP ORDERING SYSTEM — MenuItem, Order, OrderItem
// ─────────────────────────────────────────────────────────────────────────────

model MenuItem {
  id            String     @id @default(cuid())
  merchantId    String
  merchant      Merchant   @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  category      String     // e.g. "Cakes", "Pastries", "Beverages"
  name          String     // e.g. "Chocolate Truffle Cake"
  description   String?
  price         Int        // in rupees
  originalPrice Int?       // for strikethrough discount
  imageUrl      String?
  isVeg         Boolean    @default(true)
  isAvailable   Boolean    @default(true)
  sortOrder     Int        @default(0)
  tags          String?    // JSON array string: ["bestseller","new","spicy"]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  orderItems    OrderItem[]

  @@index([merchantId])
  @@index([merchantId, category])
  @@index([merchantId, isAvailable])
}

model Order {
  id              String      @id @default(cuid())
  merchantId      String
  merchant        Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customerId      String?
  customer        Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerPhone   String
  customerName    String?
  orderNo         String      // e.g. "CC-001"
  status          String      @default("PENDING")
  // PENDING | CONFIRMED | PREPARING | READY | DELIVERED | CANCELLED
  deliveryType    String      @default("pickup")  // pickup | delivery
  deliveryAddress String?
  totalAmount     Int         // in rupees
  notes           String?
  waMessageId     String?     // Evolution API message ID
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]

  @@index([merchantId])
  @@index([merchantId, status])
  @@index([merchantId, createdAt])
  @@index([customerPhone])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  quantity   Int
  unitPrice  Int
  totalPrice Int
  notes      String?
  createdAt  DateTime @default(now())

  @@index([orderId])
  @@index([menuItemId])
}


// =============================================================
// MODULE 1 & 2: DYNAMIC QR CODE ENGINE & LEAD CAPTURE
// =============================================================

model QrCode {
  id           String          @id @default(cuid())
  merchantId   String
  slug         String          @unique
  label        String?         @default("Counter QR")
  currentDest  String
  redirectMode String          @default("DIRECT") // "DIRECT" (Module 1) | "FORM_CAPTURE" (Module 2)
  tier         String          @default("LITE")   // "LITE" (Rs 100/mo) | "PRO" (Rs 599/mo)
  isActive     Boolean         @default(true)
  totalScans   Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  merchant     Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  destinations QrDestination[]
  scanEvents   QrScanEvent[]

  @@index([merchantId])
  @@index([slug])
}

model QrDestination {
  id          String   @id @default(cuid())
  qrCodeId    String
  destination String
  changedBy   String   @default("merchant")
  note        String?
  changedAt   DateTime @default(now())
  qrCode      QrCode   @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([qrCodeId])
  @@index([qrCodeId, changedAt])
}

model QrScanEvent {
  id                   String   @id @default(cuid())
  qrCodeId             String
  merchantId           String
  scannedAt            DateTime @default(now())
  deviceType           String?
  os                   String?
  browser              String?
  referrer             String?
  ipHash               String?
  isBot                Boolean  @default(false)
  registeredCustomerId String?
  qrCode               QrCode   @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([qrCodeId])
  @@index([merchantId, scannedAt])
}

// =============================================================
// MODULE 3: SMART POS BILLING & WHATSAPP INVOICING
// =============================================================

model Invoice {
  id              String            @id @default(cuid())
  merchantId      String
  customerId      String?
  billId          String?
  invoiceNumber   String            @unique
  customerName    String?
  customerPhone   String?
  paymentMode     String            @default("CASH")
  paymentStatus   String            @default("PAID")
  subtotal        Float             @default(0)
  discountAmount  Float             @default(0)
  discountType    String?           @default("flat")
  taxableAmount   Float             @default(0)
  gstRate         Float             @default(0)
  gstType         String            @default("CGST_SGST")
  cgst            Float             @default(0)
  sgst            Float             @default(0)
  igst            Float             @default(0)
  grandTotal      Float
  notes           String?
  pdfUrl          String?
  pdfGeneratedAt  DateTime?
  printedAt       DateTime?
  waStatus        String            @default("NOT_SENT")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  items           InvoiceItem[]
  waMessages      WhatsAppMessage[] @relation("InvoiceWAMessages")
  merchant        Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer        Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([merchantId])
  @@index([merchantId, createdAt])
  @@index([merchantId, waStatus])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  name        String
  category    String?
  quantity    Int      @default(1)
  unitPrice   Float
  discountAmt Float    @default(0)
  taxRate     Float    @default(0)
  taxAmount   Float    @default(0)
  totalPrice  Float
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model CustomerConsent {
  id          String    @id @default(cuid())
  customerId  String
  merchantId  String
  consentType String    @default("transactional")
  status      String    @default("opted_in")
  source      String    @default("qr_form")
  ipHash      String?
  consentedAt DateTime  @default(now())
  revokedAt   DateTime?
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  merchant    Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([customerId, merchantId])
  @@index([merchantId, consentType])
}

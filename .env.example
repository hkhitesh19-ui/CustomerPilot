# ==============================================================================
# CUSTOMERPILOT - COMPREHENSIVE ENVIRONMENT MANIFEST (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# Do not edit this file directly. 
# Run `npm run setup` to automatically generate your `.env` file via the wizard.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Description: Connection string for the PostgreSQL database.
# Default: postgresql://postgres:postgres@localhost:5432/customerpilot
# Example: postgresql://postgres:mypassword@localhost:5432/customerpilot
# Required: YES (Class A - Fully Automatic via Docker)
# How to obtain: Automatically provisioned by `docker-compose`.
# Validation: `npm run doctor` will ping the database.
# Common errors: "Connection Refused" -> Docker container isn't running.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/customerpilot"

# ------------------------------------------------------------------------------
# 2. REDIS CONFIGURATION
# ------------------------------------------------------------------------------
# Description: Connection string for the Redis instance used for caching and queues.
# Default: redis://localhost:6379/0
# Example: redis://localhost:6379/0
# Required: YES (Class A - Fully Automatic via Docker)
# How to obtain: Automatically provisioned by `docker-compose`.
# Validation: `npm run doctor` will ping the Redis cache.
# Common errors: "ECONNREFUSED" -> Redis container isn't running.
REDIS_URL="redis://localhost:6379/0"

# ------------------------------------------------------------------------------
# 3. NEXT-AUTH / SECURITY CONFIGURATION
# ------------------------------------------------------------------------------
# Description: Base64 encryption key for session security.
# Default: None
# Example: Lkz73n0x...
# Required: YES (Class A - Fully Automatic generation via Setup Wizard)
# How to obtain: Setup wizard generates this automatically.
# Validation: Wizard checks string length >= 32.
# Common errors: "JWT invalid signature" -> Key changed after sessions were created.
NEXTAUTH_SECRET="wizard_will_generate_this"

# Description: The canonical base URL of the Next.js application.
# Default: http://localhost:3000
# Example: https://app.customerpilot.com
# Required: YES (Class A)
# How to obtain: Your local URL or production domain.
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. EVOLUTION API (WHATSAPP GATEWAY)
# ------------------------------------------------------------------------------
# Description: URL pointing to your local/remote Evolution API WhatsApp gateway.
# Default: http://localhost:8080
# Example: http://localhost:8080
# Required: YES (Class A - Fully Automatic via Docker)
# How to obtain: Automatically provisioned by `docker-compose`.
EVOLUTION_API_URL="http://localhost:8080"

# Description: Global API Key to authenticate with the Evolution API instance.
# Default: None
# Example: GlobalEvolutionKey123
# Required: YES (Class A - Automatic generation via Setup Wizard)
# How to obtain: Setup wizard generates this automatically and injects it into Docker.
EVOLUTION_GLOBAL_API_KEY="wizard_will_generate_this"

# Description: Webhook secret for cryptographic verification of incoming WhatsApp messages.
# Default: None
# Example: webhook_secret_8910
# Required: YES (Class A - Automatic generation via Setup Wizard)
EVOLUTION_WEBHOOK_SECRET="wizard_will_generate_this"

# ------------------------------------------------------------------------------
# 5. GOOGLE / GCP INTEGRATION
# ------------------------------------------------------------------------------
# Description: Google Cloud API Key with Places API and Maps JavaScript API enabled.
# Default: None
# Example: AIzaSyB-1234567890abcdef
# Required: YES (Class C - Requires Founder Credential)
# How to obtain: Go to Google Cloud Console -> Create Project -> Enable Places API -> Credentials -> Create API Key.
# Validation: `npm run doctor` performs a test Places API lookup.
# Common errors: "API_KEY_INVALID" -> Key wasn't copied correctly. "REQUEST_DENIED" -> Places API not enabled.
GOOGLE_PLACES_API_KEY=""

# ------------------------------------------------------------------------------
# 6. AI / GEMINI CONFIGURATION
# ------------------------------------------------------------------------------
# Description: Google Gemini API Key for automated review replies and data extraction.
# Default: None
# Example: AIzaSyA-0987654321fedcba
# Required: YES (Class C - Requires Founder Credential)
# How to obtain: Go to Google AI Studio (aistudio.google.com) -> Get API Key.
# Validation: `npm run doctor` will run a lightweight ping against the Gemini API.
# Common errors: "403 Forbidden" -> API key is invalid or quota exceeded.
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 7. SMTP / EMAIL CONFIGURATION
# ------------------------------------------------------------------------------
# Description: SMTP server credentials for outgoing transactional emails.
# Default: None
# Example: HOST=smtp.mailtrap.io, PORT=2525
# Required: YES (Class C - Requires Founder Credential)
# How to obtain: Use a service like Mailtrap, SendGrid, or AWS SES.
# Validation: `npm run doctor` attempts an SMTP handshake without sending an email.
# Common errors: "ETIMEDOUT" -> Wrong host/port or firewall blocking.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@customerpilot.com"

# ------------------------------------------------------------------------------
# 8. RAZORPAY / BILLING CONFIGURATION
# ------------------------------------------------------------------------------
# Description: Razorpay credentials for merchant SaaS subscriptions.
# Default: None
# Example: rzp_test_123456789
# Required: YES (Class C - Requires Founder Credential)
# How to obtain: dashboard.razorpay.com -> Settings -> API Keys -> Generate Key.
# Validation: `npm run doctor` verifies the key format.
# Common errors: "Invalid API Key" -> Mixed up test and live keys.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
